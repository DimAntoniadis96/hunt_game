{
  "name": "@mimic/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && run-p -l dev:watch dev:serve",
    "dev:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --enable-source-maps --watch-path=./dist --watch-path=../shared/dist dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.45",
    "@colyseus/schema": "^4.0.30",
    "@colyseus/ws-transport": "^0.17.13",
    "@mimic/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "npm-run-all2": "^8.0.4",
    "typescript": "^5.5.4"
  }
}
